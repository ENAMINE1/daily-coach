{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ENAMINE1/daily-coach/blob/main/app/plan.schema.json",
  "title": "Daily Coach plan",
  "description": "Everything Daily Coach tracks. Three shapes: a daily routine (rhythm.daily + habits), a weekly plan (weeklyGoals + rhythm), or a multi-week program (tracks of weeks). They can be combined.",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Shown under the greeting."
        },
        "owner": {
          "type": "string",
          "description": "First name used by the coach. Fills {name}."
        },
        "description": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\d$",
          "description": "Optional. Sets calendar week 1. Defaults to the day the plan is installed."
        },
        "weekStartsOn": {
          "enum": [
            "mon",
            "sun"
          ],
          "default": "mon"
        }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "checkinFrom": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "default": "05:00",
          "description": "Earliest time the morning check-in pops up. null turns it off."
        },
        "nudgeAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "default": "21:00",
          "description": "Evening nudge if tasks or habits are open. null turns it off."
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "weeks"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "weeks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 104,
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "goal": {
                  "type": "string"
                },
                "limitQuestion": {
                  "type": "string",
                  "description": "One question you must be able to answer to call the week done."
                },
                "checklist": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Weekly targets. Ticking all of them completes the week (fireworks)."
                },
                "days": {
                  "type": "object",
                  "description": "Day-by-day subtasks for tasks on this track. Key = task id from rhythm. Value = one list of subtasks per occurrence of that task in the week (1st time it appears, 2nd time...).",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "additionalProperties": {
                "description": "Any extra text field (e.g. build, reading) can be used in templates as {week.<field>}."
              }
            }
          }
        }
      },
      "description": "Optional. Multi-week programs only. Leave out for a daily or weekly routine."
    },
    "rhythm": {
      "type": "object",
      "description": "The repeating week. Keys: mon..sun, plus shortcuts merged into each day: daily (every day), weekdays (mon-fri), weekend (sat, sun).",
      "propertyNames": {
        "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun",
          "daily",
          "weekdays",
          "weekend"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/task"
        }
      }
    },
    "habits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "default": "time",
            "description": "Singular: problem, page, glass, minute."
          },
          "target": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Count that keeps the streak alive."
          },
          "great": {
            "type": "integer",
            "minimum": 1,
            "description": "Count that counts as a great day."
          },
          "logItems": {
            "type": "boolean",
            "default": false,
            "description": "Show a text box to log what you did (e.g. problem names)."
          },
          "itemPlaceholder": {
            "type": "string"
          },
          "checkinQuestion": {
            "type": "string"
          },
          "nudge": {
            "type": "boolean",
            "default": true
          },
          "messages": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "great": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "heatmaps": {
      "type": "array",
      "description": "365-day GitHub-style graphs. Each counts subtasks of some tasks, or one habit. Omit to get one 'All tasks' map plus one per habit.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "habit": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Minimum daily count for colour levels 1-4, ascending."
          },
          "palette": {
            "description": "Colour scheme: a name, or 4 hex colours from low to high (used in both themes). Defaults rotate through the names.",
            "oneOf": [
              {
                "enum": [
                  "ocean",
                  "grape",
                  "sunset",
                  "forest",
                  "rose",
                  "teal"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "minItems": 4,
                "maxItems": 4
              }
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "tasks"
            ]
          },
          {
            "required": [
              "habit"
            ]
          }
        ]
      }
    },
    "coach": {
      "type": "object",
      "properties": {
        "tone": {
          "enum": [
            "gentle",
            "balanced",
            "strict"
          ]
        },
        "messages": {
          "type": "object",
          "description": "Lists of lines; one is picked at random. {name} is replaced.",
          "properties": {
            "good": {
              "$ref": "#/$defs/lines"
            },
            "ok": {
              "$ref": "#/$defs/lines"
            },
            "bad": {
              "$ref": "#/$defs/lines"
            },
            "start": {
              "$ref": "#/$defs/lines"
            },
            "dayDone": {
              "$ref": "#/$defs/lines"
            },
            "nudgeSoft": {
              "$ref": "#/$defs/lines"
            },
            "nudgeHard": {
              "$ref": "#/$defs/lines"
            },
            "boost": {
              "$ref": "#/$defs/lines"
            },
            "scold": {
              "$ref": "#/$defs/lines"
            },
            "praise": {
              "$ref": "#/$defs/lines"
            }
          }
        },
        "celebrations": {
          "type": "object",
          "properties": {
            "weekComplete": {
              "$ref": "#/$defs/celebration"
            },
            "dayComplete": {
              "$ref": "#/$defs/celebration"
            },
            "habitTarget": {
              "$ref": "#/$defs/celebration"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "heatmapAnimation": {
          "enum": [
            "page",
            "slide",
            "flip"
          ]
        }
      }
    },
    "dates": {
      "type": "object",
      "description": "One-off tasks on specific dates, added to that day's rhythm.",
      "propertyNames": {
        "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/task"
        }
      }
    },
    "weeklyGoals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A checklist that resets every week. Completing it fires the weekComplete celebration."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "celebration": {
      "enum": [
        "fireworks",
        "confetti",
        "boost",
        "message",
        "none"
      ]
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Reuse the same id on different days for the same kind of task."
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "Template. {week.title}, {week.<field>}, {week.number}, {track.name}, {name}."
        },
        "track": {
          "type": "string",
          "description": "Track id. Subtasks then come from that track's current week (days.<task id>)."
        },
        "minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Used when the week has no days.<task id> entry for this occurrence. Templates allowed."
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "rhythm"
      ]
    },
    {
      "required": [
        "dates"
      ]
    },
    {
      "required": [
        "weeklyGoals"
      ]
    },
    {
      "required": [
        "habits"
      ]
    }
  ]
}